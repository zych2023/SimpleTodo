{
  "name": "simpletodo",
  "displayName": "SimpleTodo",
  "version": "1.0.0",
  "private": true,
  "author": "zych2023",
  "description": "a todo list application",
  "repository": {
    "type": "git",
    "url": "https://github.com/zych2023/SimpleTodo.git"
  },
  "contributors": [
    "xiajingren (original author)",
    "zych2023"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "lint": "eslint src/",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "electron:build:win": "electron-vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "build": {
    "appId": "simpletodo",
    "productName": "SimpleTodo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2020 xhznl",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "tray*.png",
          "license*.txt"
        ]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "resources/logo.ico",
      "executableName": "SimpleTodo",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "SimpleTodo",
      "shortcutName": "SimpleTodo"
    },
    "mac": {
      "icon": "resources/logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": {
        "target": "default",
        "arch": "universal"
      }
    },
    "publish": [
      "github"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
